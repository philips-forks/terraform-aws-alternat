#!/usr/bin/env bash

CWAGENT_CONFIG_DIR="/opt/aws/amazon-cloudwatch-agent/etc"
CWAGENT_CONFIG_FILE="$CWAGENT_CONFIG_DIR/amazon-cloudwatch-agent.json"

# Check if parent directory exists and is writable
if [ ! -d $CWAGENT_CONFIG_DIR ] || [ ! -w $CWAGENT_CONFIG_DIR ]; then
    echo "Error: Directory $CWAGENT_CONFIG_DIR does not exist or is not writable"
    exit 1
fi

# Resolve which network interfaces the agent should watch. The primary
# (default-route) interface is always included so net/ethtool metrics keep
# working across instance families that enumerate NICs differently (e.g. ens5
# on older families, ens34 on newer ones). Any configured interfaces are added
# only if they actually exist on this host.
CONFIGURED_INTERFACES=$(echo '${cloudwatch_interfaces}' | tr -d '[]"' | tr ',' ' ')
PRIMARY_INTERFACE=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')

CW_SEEN=""
CW_INTERFACES_JSON=""
add_cw_iface() {
    case " $CW_SEEN " in
        *" $1 "*) return 0 ;;
    esac
    CW_SEEN="$CW_SEEN $1"
    if [ -n "$CW_INTERFACES_JSON" ]; then
        CW_INTERFACES_JSON="$CW_INTERFACES_JSON,"
    fi
    CW_INTERFACES_JSON="$CW_INTERFACES_JSON\"$1\""
}
if [ -n "$PRIMARY_INTERFACE" ]; then
    add_cw_iface "$PRIMARY_INTERFACE"
fi
for iface in $CONFIGURED_INTERFACES; do
    if [ -n "$iface" ] && ip link show dev "$iface" > /dev/null 2>&1; then
        add_cw_iface "$iface"
    fi
done
# Fall back to the configured list if nothing was detected (e.g. no default route yet).
if [ -z "$CW_INTERFACES_JSON" ]; then
    CW_INTERFACES_JSON=$(echo '${cloudwatch_interfaces}' | tr -d '[] ')
fi
CW_INTERFACES_JSON="[$CW_INTERFACES_JSON]"

# ethtool is required by the ENA allowance-metric publisher below and is not
# guaranteed to be on the base AMI. Best-effort install; the publisher no-ops if absent.
if ! command -v ethtool > /dev/null 2>&1; then
    if command -v dnf > /dev/null 2>&1; then
        dnf install -y ethtool || true
    elif command -v yum > /dev/null 2>&1; then
        yum install -y ethtool || true
    elif command -v apt-get > /dev/null 2>&1; then
        apt-get update -y || true
        apt-get install -y ethtool || true
    fi
fi

# bpftrace powers the packet-drop classifier publisher below. Best-effort
# install; the publisher stays idle if bpftrace is unavailable.
if ! command -v bpftrace > /dev/null 2>&1; then
    if command -v dnf > /dev/null 2>&1; then
        dnf install -y bpftrace || true
    elif command -v yum > /dev/null 2>&1; then
        yum install -y bpftrace || true
    elif command -v apt-get > /dev/null 2>&1; then
        apt-get install -y bpftrace || true
    fi
fi

# Configuration that aims to report most metrics as provided for managed NAT Gateways.
#
# Adapted from the fck-nat project. All credit goes to its original contributors.
# Original documentation: https://fck-nat.dev/develop/features/#metrics
cat <<EOF > $CWAGENT_CONFIG_FILE
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root",
    "usage_data": false
  },
  "metrics": {
    "namespace": "${cloudwatch_namespace}",
    "metrics_collected": {
      "cpu": {
        "resources": ["*"],
        "totalcpu": true,
        "measurement": [
          { "name": "usage_active", "rename": "CpuUsageActive", "unit": "Percent" },
          { "name": "usage_iowait", "rename": "CpuUsageIoWait", "unit": "Percent" }
        ],
        "append_dimensions": {
          "AvailabilityZone": "${az}"
        }
      },
      "disk": {
        "resources": ["/"],
        "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs"],
        "measurement": [
          { "name": "used_percent", "rename": "DiskUsedPercent", "unit": "Percent" }
        ],
        "append_dimensions": {
          "AvailabilityZone": "${az}"
        }
      },
      "swap": {
        "measurement": [
          { "name": "used_percent", "rename": "SwapUsedPercent", "unit": "Percent" }
        ],
        "append_dimensions": {
          "AvailabilityZone": "${az}"
        }
      },
      "net": {
        "resources": $CW_INTERFACES_JSON,
        "measurement": [
          { "name": "bytes_recv", "rename": "BytesIn",  "unit": "Bytes" },
          { "name": "bytes_sent", "rename": "BytesOut",  "unit": "Bytes" },
          { "name": "packets_sent", "rename": "PacketsOutCount",  "unit": "Count" },
          { "name": "packets_recv", "rename": "PacketsInCount",  "unit": "Count" },
          { "name": "drop_in", "rename": "PacketsDropInCount",  "unit": "Count" },
          { "name": "drop_out", "rename": "PacketsDropOutCount",  "unit": "Count" }
        ],
        "append_dimensions": {
          "AvailabilityZone": "${az}"
        }
      },
      "netstat": {
        "measurement": [
          { "name": "tcp_syn_sent", "rename": "ConnectionAttemptOutCount",  "unit": "Count" },
          { "name": "tcp_syn_recv", "rename": "ConnectionAttemptInCount",  "unit": "Count" },
          { "name": "tcp_established", "rename": "ConnectionEstablishedCount",  "unit": "Count" },
          { "name": "tcp_close_wait", "rename": "ConnectionCloseWaitCount",  "unit": "Count" },
          { "name": "tcp_time_wait", "rename": "ConnectionTimeWaitCount",  "unit": "Count" }
        ],
        "append_dimensions": {
          "AvailabilityZone": "${az}"
        }
      },
      "mem": {
        "measurement": [
          { "name": "used_percent", "rename": "MemoryUsed",  "unit": "Percent" }
        ],
        "append_dimensions": {
          "AvailabilityZone": "${az}"
        }
      }
    },
    "append_dimensions": {
      "InstanceId": "\$${aws:InstanceId}",
      "AutoScalingGroupName": "\$${aws:AutoScalingGroupName}"
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/alternat-packet-drops.log",
            "log_group_name": "${cloudwatch_namespace}/packet-drops",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC",
            "timestamp_format": "%Y-%m-%dT%H:%M:%SZ",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}
EOF

# Ensure the drop-detail log exists before the agent starts tailing it. The
# resident eBPF publisher (below) appends per-drop JSON records here.
touch /var/log/alternat-packet-drops.log
chmod 0640 /var/log/alternat-packet-drops.log

systemctl restart amazon-cloudwatch-agent

# CWAgent has no uptime plugin, so a small systemd timer emits InstanceUptimeSeconds.
cat <<'PUBLISH_UPTIME_SCRIPT' > /usr/local/bin/alternat-publish-uptime.sh
#!/usr/bin/env bash
set -euo pipefail
TOKEN=$(curl -sSf --retry 3 --retry-delay 1 -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
IID=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
REGION=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
AZ=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)
UPTIME=$(awk '{print int($1)}' /proc/uptime)
aws cloudwatch put-metric-data \
  --region "$REGION" \
  --namespace "${cloudwatch_namespace}" \
  --metric-name InstanceUptimeSeconds \
  --unit Seconds \
  --value "$UPTIME" \
  --dimensions "InstanceId=$IID,AvailabilityZone=$AZ"
PUBLISH_UPTIME_SCRIPT
chmod 0755 /usr/local/bin/alternat-publish-uptime.sh

cat <<'PUBLISH_UPTIME_SERVICE' > /etc/systemd/system/alternat-publish-uptime.service
[Unit]
Description=Publish alterNAT instance uptime to CloudWatch
After=network-online.target amazon-cloudwatch-agent.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/alternat-publish-uptime.sh
PUBLISH_UPTIME_SERVICE

cat <<'PUBLISH_UPTIME_TIMER' > /etc/systemd/system/alternat-publish-uptime.timer
[Unit]
Description=Publish alterNAT instance uptime every 5 minutes

[Timer]
OnBootSec=60s
OnUnitActiveSec=5min
Unit=alternat-publish-uptime.service

[Install]
WantedBy=timers.target
PUBLISH_UPTIME_TIMER

systemctl daemon-reload
systemctl enable --now alternat-publish-uptime.timer

# The CWAgent telegraf ethtool input silently returns no metrics on some instance
# families (e.g. c8gn/Nitro v5), so publish the ENA allowance counters directly
# from `ethtool -S` on the primary interface instead. Same metric names/dimensions
# as the former ethtool plugin, so dashboards and alarms are unaffected.
cat <<'PUBLISH_ETHTOOL_SCRIPT' > /usr/local/bin/alternat-publish-ethtool.sh
#!/usr/bin/env bash
set -euo pipefail
IFACE=$(ip -o -4 route show to default | awk '{print $5; exit}')
[ -z "$IFACE" ] && exit 0
command -v ethtool > /dev/null 2>&1 || exit 0
STATS=$(ethtool -S "$IFACE" 2>/dev/null) || exit 0
[ -z "$STATS" ] && exit 0
TOKEN=$(curl -sSf --retry 3 --retry-delay 1 -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
IID=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
REGION=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
AZ=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)
ASG=$(aws ec2 describe-tags --region "$REGION" --filters "Name=resource-id,Values=$IID" "Name=key,Values=aws:autoscaling:groupName" --query 'Tags[0].Value' --output text 2>/dev/null || true)
DIMS="InstanceId=$IID,AvailabilityZone=$AZ,interface=$IFACE"
if [ -n "$ASG" ] && [ "$ASG" != "None" ]; then
  DIMS="$DIMS,AutoScalingGroupName=$ASG"
fi
publish_stat() {
  value=$(printf '%s\n' "$STATS" | awk -v k="$1:" '$1==k{print $2; exit}')
  [ -z "$value" ] && return 0
  aws cloudwatch put-metric-data --region "$REGION" --namespace "${cloudwatch_namespace}" --metric-name "$2" --unit Count --value "$value" --dimensions "$DIMS"
}
publish_stat bw_in_allowance_exceeded ethtool_bw_in_allowance_exceeded
publish_stat bw_out_allowance_exceeded ethtool_bw_out_allowance_exceeded
publish_stat pps_allowance_exceeded ethtool_pps_allowance_exceeded
publish_stat conntrack_allowance_exceeded ethtool_conntrack_allowance_exceeded
PUBLISH_ETHTOOL_SCRIPT
chmod 0755 /usr/local/bin/alternat-publish-ethtool.sh

cat <<'PUBLISH_ETHTOOL_SERVICE' > /etc/systemd/system/alternat-publish-ethtool.service
[Unit]
Description=Publish alterNAT ENA allowance metrics to CloudWatch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/alternat-publish-ethtool.sh
PUBLISH_ETHTOOL_SERVICE

cat <<'PUBLISH_ETHTOOL_TIMER' > /etc/systemd/system/alternat-publish-ethtool.timer
[Unit]
Description=Publish alterNAT ENA allowance metrics every minute

[Timer]
OnBootSec=60s
OnUnitActiveSec=1min
Unit=alternat-publish-ethtool.service

[Install]
WantedBy=timers.target
PUBLISH_ETHTOOL_TIMER

systemctl daemon-reload
systemctl enable --now alternat-publish-ethtool.timer

# Netdev drop counters (PacketsDropInCount) are a single scalar with no per-packet
# destination, so they cannot distinguish forwarded-traffic loss from benign
# host-local drops (e.g. the node's own SSM/CloudWatch-agent HTTPS connections
# being torn down, which land as NO_SOCKET / TCP_ABORT_ON_DATA to this node's own
# IP). This resident eBPF publisher classifies genuine drops (skb:kfree_skb with
# reason > 2; reason 2 NOT_SPECIFIED is the benign GRO free path) by whether the
# destination is this node's own IP, and emits two metrics so alerting can target
# real forwarded-traffic loss (ForwardedPacketDropCount) and ignore host-local
# noise (HostLocalPacketDropCount). Each forwarded drop is additionally recorded
# (reason code + protocol + src/dst ip:port, plus the pre-SNAT/original client
# IP from conntrack when available) as a JSON line in
# /var/log/alternat-packet-drops.log, which the CloudWatch agent ships to the
# "${cloudwatch_namespace}/packet-drops" log group for post-hoc investigation.
# Per-minute log volume is capped to avoid flooding during a drop storm; the
# count metrics remain authoritative. No-ops if bpftrace is unavailable.
cat <<'PUBLISH_DROPS_SCRIPT' > /usr/local/bin/alternat-publish-drops.sh
#!/usr/bin/env bash
set -uo pipefail
command -v bpftrace > /dev/null 2>&1 || exec sleep infinity
IFACE=$(ip -o -4 route show to default | awk '{print $5; exit}')
[ -z "$IFACE" ] && exec sleep infinity
LOCAL_IP=$(ip -o -4 addr show dev "$IFACE" | awk '{print $4}' | cut -d/ -f1 | head -1)
[ -z "$LOCAL_IP" ] && exec sleep infinity
# bpftrace reads iph->daddr as a little-endian u32: a.b.c.d -> a|(b<<8)|(c<<16)|(d<<24)
IFS=. read -r o1 o2 o3 o4 <<< "$LOCAL_IP"
LOCAL_LE=$(( o1 | (o2 << 8) | (o3 << 16) | (o4 << 24) ))
TOKEN=$(curl -sSf --retry 3 --retry-delay 1 -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
IID=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
REGION=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
AZ=$(curl -sSf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)
ASG=$(aws ec2 describe-tags --region "$REGION" --filters "Name=resource-id,Values=$IID" "Name=key,Values=aws:autoscaling:groupName" --query 'Tags[0].Value' --output text 2>/dev/null || true)
DIMS="InstanceId=$IID,AvailabilityZone=$AZ,interface=$IFACE"
if [ -n "$ASG" ] && [ "$ASG" != "None" ]; then
  DIMS="$DIMS,AutoScalingGroupName=$ASG"
fi

cat > /run/alternat-drops.bt <<'BT'
BEGIN { @fwd = 0; @local = 0; }
tracepoint:skb:kfree_skb / args->reason > 2 /
{
  $skb = (struct sk_buff *)args->skbaddr;
  $nh = $skb->network_header;
  if ($nh == 0) { return; }
  $iph = (struct iphdr *)($skb->head + $nh);
  $daddr = $iph->daddr;
  if ($daddr == (uint32)$1) { @local = @local + 1; return; }
  @fwd = @fwd + 1;
  $saddr = $iph->saddr;
  $proto = $iph->protocol;
  $ihl = (*(uint8 *)$iph) & 0x0f;
  $th = $skb->head + $nh + ($ihl << 2);
  $sport = 0;
  $dport = 0;
  if ($proto == 6 || $proto == 17) {
    $sp = *(uint16 *)($th);
    $dp = *(uint16 *)($th + 2);
    $sport = (($sp & 0xff) << 8) | (($sp >> 8) & 0xff);
    $dport = (($dp & 0xff) << 8) | (($dp >> 8) & 0xff);
  }
  // Pre-SNAT source from the skb conntrack entry (skb->_nfct, low 3 bits are
  // ctinfo). For a masqueraded flow the ORIGINAL-direction tuple source is the
  // real client (runner) IP; 0.0.0.0 when no ct is attached.
  $orig = (uint32)0;
  $nfct = $skb->_nfct;
  if ($nfct != 0) {
    $ct = (struct nf_conn *)($nfct & ~7);
    $orig = $ct->tuplehash[0].tuple.src.u3.ip;
  }
  printf("DROPINFO %d %d %d.%d.%d.%d %d %d.%d.%d.%d %d %d.%d.%d.%d\n",
    args->reason, $proto,
    $saddr & 0xff, ($saddr >> 8) & 0xff, ($saddr >> 16) & 0xff, ($saddr >> 24) & 0xff, $sport,
    $daddr & 0xff, ($daddr >> 8) & 0xff, ($daddr >> 16) & 0xff, ($daddr >> 24) & 0xff, $dport,
    $orig & 0xff, ($orig >> 8) & 0xff, ($orig >> 16) & 0xff, ($orig >> 24) & 0xff);
}
interval:s:60 { printf("DROPMETRIC %d %d\n", @fwd, @local); @fwd = 0; @local = 0; }
BT

DROP_LOG="/var/log/alternat-packet-drops.log"
LOG_CAP_PER_MIN=500
logged=0
suppressed=0
stdbuf -oL bpftrace /run/alternat-drops.bt "$LOCAL_LE" 2>/dev/null | while read -r tag f1 f2 f3 f4 f5 f6 f7; do
  case "$tag" in
    DROPMETRIC)
      case "$f1$f2" in *[!0-9]*) continue ;; esac
      aws cloudwatch put-metric-data --region "$REGION" --namespace "${cloudwatch_namespace}" --metric-name ForwardedPacketDropCount --unit Count --value "$f1" --dimensions "$DIMS"
      aws cloudwatch put-metric-data --region "$REGION" --namespace "${cloudwatch_namespace}" --metric-name HostLocalPacketDropCount --unit Count --value "$f2" --dimensions "$DIMS"
      if [ "$suppressed" -gt 0 ]; then
        printf '{"ts":"%s","event":"suppressed","dropped_lines":%d}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$suppressed" >> "$DROP_LOG"
      fi
      logged=0
      suppressed=0
      ;;
    DROPINFO)
      if [ "$logged" -lt "$LOG_CAP_PER_MIN" ]; then
        pname="$f2"
        case "$f2" in 6) pname=tcp ;; 17) pname=udp ;; 1) pname=icmp ;; esac
        origsrc="$f7"
        case "$origsrc" in ""|0.0.0.0) origsrc="unknown" ;; esac
        printf '{"ts":"%s","reason":%s,"proto":"%s","src":"%s:%s","dst":"%s:%s","orig_src":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$f1" "$pname" "$f3" "$f4" "$f5" "$f6" "$origsrc" >> "$DROP_LOG"
        logged=$((logged + 1))
      else
        suppressed=$((suppressed + 1))
      fi
      ;;
  esac
done
PUBLISH_DROPS_SCRIPT
chmod 0755 /usr/local/bin/alternat-publish-drops.sh

cat <<'DROPS_LOGROTATE' > /etc/logrotate.d/alternat-packet-drops
/var/log/alternat-packet-drops.log {
  daily
  rotate 7
  maxsize 20M
  missingok
  notifempty
  copytruncate
  compress
  delaycompress
}
DROPS_LOGROTATE

cat <<'PUBLISH_DROPS_SERVICE' > /etc/systemd/system/alternat-publish-drops.service
[Unit]
Description=Publish alterNAT packet-drop classification to CloudWatch
After=network-online.target amazon-cloudwatch-agent.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/alternat-publish-drops.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
PUBLISH_DROPS_SERVICE

systemctl daemon-reload
systemctl enable --now alternat-publish-drops.service
